NODE_ENV=production
COMPOSE_PROJECT_NAME=private-duo
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_DATABASE_PASSWORD
PORT=4000
TRUST_PROXY=1
COOKIE_SECURE=true
WEB_ORIGIN=https://your-domain.example
DATABASE_URL=postgresql://duo:CHANGE_ME@localhost:5432/private_duo?schema=public
HOST_INITIAL_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
GUEST_INITIAL_PASSWORD=CHANGE_TO_A_DIFFERENT_LONG_RANDOM_PASSWORD
INITIAL_PROMO_CODE=CHANGE_THIS_PROMO_CODE
SESSION_DAYS=7
NEXT_PUBLIC_API_URL=

# The upload ceiling is saved in Admin → Media & uploads and stored in the
# database. It is not configured through the environment.

# Host ports chosen by scripts/deploy-production.sh. All app ports bind to
# 127.0.0.1; these values must not collide with existing VPS services.
DUO_HTTP_PORT=8085
DUO_DB_PORT=5432
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# WebRTC / coturn. TURN credentials are intentionally visible to browsers.
TURN_REALM=your-domain.example
TURN_USERNAME=private-duo
TURN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_TURN_PASSWORD
TURN_EXTERNAL_IP=YOUR_VPS_PUBLIC_IP
NEXT_PUBLIC_TURN_URL=turn:your-domain.example:3478?transport=udp
NEXT_PUBLIC_TURN_USERNAME=private-duo
NEXT_PUBLIC_TURN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_TURN_PASSWORD

# Optional background Web Push. Leave blank to use only in-app/browser notifications.
VAPID_SUBJECT=mailto:admin@your-domain.example
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
