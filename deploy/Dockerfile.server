FROM node:22-alpine AS build
RUN apk add --no-cache openssl
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/server/package.json ./apps/server/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY prisma ./prisma
RUN npm ci --workspace=@private-duo/server --include-workspace-root
COPY apps/server ./apps/server
RUN npx prisma generate && npm run build -w @private-duo/server

FROM node:22-alpine AS runtime
RUN apk add --no-cache openssl tini
WORKDIR /app
RUN mkdir -p /var/lib/private-duo/media && chown -R node:node /var/lib/private-duo
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PRISMA_HIDE_UPDATE_MESSAGE=1 \
    CHECKPOINT_DISABLE=1 \
    MEDIA_STORAGE_DIR=/var/lib/private-duo/media
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/server ./apps/server
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/package-lock.json ./package-lock.json
COPY --from=build /app/apps/web/package.json ./apps/web/package.json
COPY deploy/entrypoint-api.sh /usr/local/bin/private-duo-entrypoint.sh
RUN chmod +x /usr/local/bin/private-duo-entrypoint.sh && chown -R node:node /app
USER node
EXPOSE 4000
ENTRYPOINT ["tini","--","/usr/local/bin/private-duo-entrypoint.sh"]
