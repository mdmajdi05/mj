generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  HOST
  GUEST
}
enum MessageDestination {
  CHAT
  GAME
}
enum ConversationStatus {
  ACTIVE
  ARCHIVED
  DELETED
}
enum PermissionStatus {
  REQUESTED
  GRANTED
  REJECTED
  REVOKED
}
enum CallStatus {
  RINGING
  CONNECTING
  ACTIVE
  ENDED
  DECLINED
}

model User {
  id                 String            @id @default(cuid())
  username           String            @unique
  displayName        String?
  role               Role
  passwordHash       String
  chatUnlocked       Boolean           @default(false)
  lastSeenAt         DateTime?
  /// Soft-deleted accounts stay in the database so the Host can restore them
  /// from the Users recycle bin. Sessions are revoked while this is set.
  deletedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  sessions           Session[]
  sentMessages       Message[]
  gameMessages       GameMessage[]
  notifications      Notification[]    @relation("NotificationRecipient")
  sentNotifications  Notification[]    @relation("NotificationActor")
  requestedPermissions Permission[]    @relation("PermissionRequester")
  grantedPermissions  Permission[]     @relation("PermissionGranter")
  callParticipants   CallParticipant[]
  pushSubscriptions  PushSubscription[]
  messageHides       MessageHide[]
  @@index([role, deletedAt])
}
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}
model Conversation {
  id        String             @id @default(cuid())
  status    ConversationStatus @default(ACTIVE)
  hostId    String?
  guestId   String?
  /// When the Host removes a chat from their list, this is set and the chat is
  /// hidden from Host contacts until a new message arrives or it is restored.
  hostHiddenAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  messages  Message[]
  @@unique([hostId, guestId])
  @@index([status, updatedAt])
  @@index([hostId, hostHiddenAt])
}
model Message {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User              @relation(fields: [senderId], references: [id])
  content        String
  destination    MessageDestination @default(CHAT)
  createdAt      DateTime          @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  deletedAt      DateTime?
  attachmentId   String?
  attachmentKind String?
  attachmentMime String?
  attachmentName String?
  attachmentSize Float?
  replyToId      String?
  replyTo        Message?          @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]         @relation("MessageReply")
  editedAt       DateTime?
  hides          MessageHide[]
  @@index([conversationId, createdAt])
  @@index([destination, createdAt])
  @@index([replyToId])
}

/// Per-account visibility. Hiding a message removes it from that account's
/// list only; the other participant keeps their copy until they hide it.
model MessageHide {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([messageId, userId])
  @@index([userId])
}
/// Private image/video/audio/file attachments. New bytes are streamed to the
/// durable media volume and referenced by `storageKey`; nullable `data` keeps
/// attachments created by older builds readable. `size` is a double so files
/// larger than 2 GB can be described without overflowing a 32-bit Int.
model ChatMedia {
  id         String   @id @default(cuid())
  ownerId    String
  kind       String
  mimeType   String
  fileName   String?
  size       Float
  data       Bytes?
  storageKey String?  @unique
  createdAt  DateTime @default(now())
  @@index([ownerId])
}

/// Singleton row holding the Host-managed global media upload ceiling. The
/// saved value is authoritative for images, videos, voice notes and files.
model MediaSetting {
  id          String   @id @default("global")
  maxUploadMb Int      @default(2048)
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}
model Game {
  id       String        @id @default(cuid())
  slug     String        @unique
  name     String
  enabled  Boolean       @default(true)
  sessions GameSession[]
}
model GameSession {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id])
  userId    String
  startedAt DateTime @default(now())
  endedAt   DateTime?
  score     Int      @default(0)
  activity  Json?
  @@index([userId, startedAt])
}
model GameMessage {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation(fields: [senderId], references: [id])
  recipientId String?
  content     String
  createdAt   DateTime @default(now())
  readAt      DateTime?
  @@index([createdAt])
  @@index([recipientId, readAt])
}
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id])
  eventType String
  payload   Json
  createdAt DateTime @default(now())
  readAt    DateTime?
  @@index([userId, readAt, createdAt])
}
/// Global, Host-managed switch for the whole notification feature. When this is
/// off no chat notification is created or pushed to any account and the
/// notification options are hidden from every user's Settings screen.
model NotificationSetting {
  id        String   @id @default("global")
  enabled   Boolean  @default(true)
  updatedBy String?
  updatedAt DateTime @updatedAt
  /// Admin-configurable push notification copy per event type, e.g.
  /// { NEW_MESSAGE: "Best deal $10", GAME_MESSAGE: "Pay only $5" }.
  notificationTexts Json?
  /// Admin-configurable incoming call button labels.
  callAcceptText String?
  callRejectText String?
}

model NotificationPreference {
  id               String  @id @default(cuid())
  userId           String  @unique
  butterfly        Boolean @default(true)
  sound            Boolean @default(false)
  browser          Boolean @default(false)
  activitySharing  Boolean @default(false)
}
model UserPreference {
  id             String  @id @default(cuid())
  userId         String  @unique
  reducedMotion  Boolean @default(false)
  theme          String  @default("dark")
  activePeerId   String?
  defaultPeerMicOn Boolean @default(true)
  chatNotifications Boolean @default(true)
  /// Admin-controlled per-type grants for this account (true = allowed).
  /// The Host can disable push, butterfly or sound notifications individually.
  adminPushNotifications Boolean @default(true)
  adminButterflyNotifications Boolean @default(true)
  adminSoundNotifications Boolean @default(true)
}
model AccessCode {
  id        String   @id @default(cuid())
  codeHash  String   @unique
  purpose   String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}
model Permission {
  id          String           @id @default(cuid())
  name        String
  description String
  status      PermissionStatus @default(REQUESTED)
  requestedBy String
  requester   User             @relation("PermissionRequester", fields: [requestedBy], references: [id])
  grantedBy   String?
  grantor     User?            @relation("PermissionGranter", fields: [grantedBy], references: [id])
  createdAt   DateTime         @default(now())
  grantedAt   DateTime?
  rejectedAt  DateTime?
  revokedAt   DateTime?
  @@index([status, createdAt])
}
model Call {
  id           String            @id @default(cuid())
  status       CallStatus        @default(RINGING)
  startedAt    DateTime          @default(now())
  endedAt      DateTime?
  participants CallParticipant[]
}
model CallParticipant {
  id           String    @id @default(cuid())
  callId       String
  call         Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  joinedAt     DateTime?
  leftAt       DateTime?
  selfMuted    Boolean   @default(false)
  mutedByPeer  Boolean   @default(false)
  speakerOn    Boolean   @default(true)
  @@unique([callId, userId])
}
model ArchivedConversation {
  id             String   @id @default(cuid())
  conversationId String   @unique
  archivedBy     String
  archivedAt     DateTime @default(now())
}
model RestoreEvent {
  id        String   @id @default(cuid())
  userId    String
  result    String
  createdAt DateTime @default(now())
}
model ScreenPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  screen      String
  chatVisible Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}
model ButterflyNotificationEvent {
  id        String   @id @default(cuid())
  userId    String
  dedupeKey String   @unique
  createdAt DateTime @default(now())
}
model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([actorId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  @@index([userId])
}

/// Host-managed seed messages shown when the Study Assistant opens.
model StudyMessage {
  id        String   @id @default(cuid())
  role      String   @default("ASSISTANT")
  text      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([sortOrder])
}

/// Host-managed keyword replies used by the Study Assistant.
model StudyReply {
  id        String   @id @default(cuid())
  keywords  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([sortOrder])
}
